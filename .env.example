# Database (PostgreSQL RDS)
DATABASE_URL=postgresql://user:password@host:5432/evss_v2

# JWT
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# TOS (Volcengine Object Storage)
TOS_ACCESS_KEY=your-access-key
TOS_SECRET_KEY=your-secret-key
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_BUCKET=your-bucket-name

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generation Provider (P1 默认 seedream；openai-image 为兜底串行链；mock 为测试桩)
# GENERATION_PROVIDER=seedream
GENERATION_PROVIDER=openai-image

# -------- 兜底 Provider: gpt-image-2（beikun / grsai 兼容，串行链式降级用） --------
OPENAI_IMAGE_ENDPOINT=https://beikun.xyz
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_API_KEY=sk-...
OPENAI_IMAGE_MAX_COUNT=1
# 0 = 同步（beikun 标准 /v1/images/generations + /v1/images/edits）；1 = 异步（grsai /v1/draw/*）
OPENAI_IMAGE_ASYNC_MODE=0
OPENAI_IMAGE_TIMEOUT_MS=120000

# -------- 主链路 Provider: 火山方舟 Seedream 5.0 Pro（原生多 bbox 一次调用） --------
# Ark 控制台开通后拿到 API Key，模型 ID 固定为 doubao-seedream-5-0-pro-260628
SEEDREAM_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
# 一次最多返回候选数（1~4，默认 4）
SEEDREAM_MAX_COUNT=4
# Seedream 调用失败（网络/限流/报错）时是否自动降级到 openai-image 串行链，默认 1=允许降级
SEEDREAM_FALLBACK_TO_CHAIN=1
